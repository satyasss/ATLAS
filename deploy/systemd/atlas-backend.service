[Unit]
Description=Atlas Spring Boot backend
After=network.target mysql.service

[Service]
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas/backend
EnvironmentFile=/opt/atlas/backend/.env
ExecStart=/usr/bin/java -Xms256m -Xmx1536m -jar /opt/atlas/backend/atlas-backend.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
